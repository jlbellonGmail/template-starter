{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://template.local/agentic/schemas/agents.schema.json",
  "title": "agents.json schema",
"description": "Describe roles canonicos por capacidades y sus adaptadores de ejecucion.",
  "type": "object",
  "required": ["roles"],
"properties": {
    "$schema": { "type": "string" },
    "generatedNotice": { "type": "string" },
    "opencodeInstructions": {
      "type": "array",
      "items": { "type": "string" }
    },
"roles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["description", "prompt", "claude", "codex", "opencode"],
"properties": {
"capabilities": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "description": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string", "minLength": 1 },
          "claude": {
            "type": "object",
            "required": ["tools", "model", "effort"],
            "properties": {
              "tools": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" }
              },
              "model": { "type": "string", "minLength": 1 },
              "effort": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          "codex": {
            "type": "object",
            "required": ["model", "model_reasoning_effort"],
            "properties": {
              "model": { "type": "string", "minLength": 1 },
              "model_reasoning_effort": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          "opencode": {
            "type": "object",
            "required": ["mode", "model", "reasoningEffort", "permission"],
            "properties": {
              "mode": { "type": "string", "minLength": 1 },
              "model": { "type": "string", "minLength": 1 },
              "reasoningEffort": { "type": "string", "minLength": 1 },
              "permission": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": { "type": "string" }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
